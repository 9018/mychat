{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openmontage/artifacts/qa_report",
  "title": "Quality Assurance Report",
  "type": "object",
  "required": ["version", "project_id", "status", "primary_family", "families_checked", "checks", "evidence"],
  "properties": {
    "version": { "type": "string", "const": "1.0" },
    "project_id": { "type": "string", "minLength": 1 },
    "status": { "type": "string", "enum": ["pass", "fail", "blocked"] },
    "preview_kind": { "type": "string", "enum": ["technical_only", "creative_dynamic_local", "provider_creative"] },
    "creative_status": { "type": "string", "enum": ["blocked", "awaiting_human_review", "approved", "failed"] },
    "provenance_path": { "type": "string" },
    "source_labeling": { "type": "string" },
    "review_packet_path": { "type": "string" },
    "primary_family": { "type": "string" },
    "families_checked": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "checks": { "type": "object", "additionalProperties": { "type": "object" } },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "timestamp", "kind"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "timestamp": { "type": "string", "minLength": 1 },
          "kind": { "type": "string", "enum": ["frame", "metric", "tool_output", "approval"] },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "note": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "failed_checks": { "type": "object" },
    "approvals": { "type": "array", "items": { "type": "object" } },
    "technical_checks": { "type": "object" },
    "score_provenance": {
      "type": "object",
      "additionalProperties": { "type": "array", "items": { "type": "string" } }
    },
    "semantic_qa_report_ref": {
      "type": "object",
      "required": ["artifact_id", "artifact_hash", "status"],
      "properties": {
        "artifact_id": { "type": "string", "minLength": 1 },
        "artifact_path": { "type": "string" },
        "artifact_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "contract_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "status": { "type": "string", "enum": ["pass", "fail", "blocked"] }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
